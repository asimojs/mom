{
    "name": "mom-project",
    "description": "Component system for react apps",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/asimojs/mom"
    },
    "license": "MIT",
    "scripts": {
        "test-mom": "pnpm --filter @asimojs/mom test run",
        "test": "pnpm run test-mom",
        "build-mom": "pnpm --filter @asimojs/mom build",
        "build": "pnpm run build-mom",
        "prepublishOnly": "pnpm run build && pnpm test",
        "docs:dev": "pnpm --filter @asimojs/mom-docs dev",
        "docs:build": "pnpm --filter @asimojs/mom-docs build",
        "docs:preview": "pnpm --filter @asimojs/mom-docs preview"
    },
    "packageManager": "pnpm@10.30.3"
}
