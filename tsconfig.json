{
    "compilerOptions": {
        "declaration": true,
        "outDir": "lib",
        "esModuleInterop": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "removeComments": false,
        "preserveConstEnums": true,
        "jsx": "react-jsx",
        "lib": ["ESNext", "DOM"]
    },
    "exclude": ["node_modules", "lib", "misc"]
}
