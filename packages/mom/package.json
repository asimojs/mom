{
    "name": "@asimojs/mom",
    "version": "0.0.1",
    "description": "mom - component system for react apps",
    "main": "dist/mom.mjs",
    "types": "dist/index.d.ts",
    "typings": "dist/index.d.ts",
    "type": "module",
    "files": [
        "src",
        "dist"
    ],
    "author": "Bertrand Laporte",
    "repository": {
        "type": "git",
        "url": "https://github.com/asimojs/mom"
    },
    "license": "MIT",
    "bugs": "https://github.com/asimojs/mom/issues",
    "keywords": [
        "HMVC",
        "MVC",
        "state",
        "ui components",
        "reactive",
        "reactivity",
        "mobx",
        "observable",
        "react",
        "preact",
        "model",
        "integration tests"
    ],
    "scripts": {
        "clean": "rimraf dist lib",
        "build": "pnpm run clean && tsc && vite build && cp -R lib/*.d.ts dist",
        "test": "vitest",
        "coverage": "vitest run --coverage",
        "prepublishOnly": "pnpm run build && vitest run",
        "npm-publish": "pnpm run prepublishOnly && npm publish --access public"
    },
    "dependencies": {
        "@asimojs/asimo": "^7.1.0"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "@vitest/coverage-v8": "^5.1.0",
        "@vitejs/plugin-react": "^6.2.1",
        "mobx": "^7.1.5",
        "mobx-react-lite": "5.1.2",
        "react": "19.3.1",
        "rimraf": "6.1.4",
        "typescript": "^7.0.2",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    }
}
